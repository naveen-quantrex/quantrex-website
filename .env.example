# Copy to .env.local for local development. Set the same names in Vercel > Project > Settings > Environment Variables.

# --- Contact form (src/app/api/contact/route.ts) ---
# Required for the form to send. Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries are delivered. Defaults to siteConfig.contactEmail (src/config/site.ts).
CONTACT_TO_EMAIL=

# Sender address. Must be on a domain verified in Resend, e.g. "Website <no-reply@yourdomain.com>".
# If unset, falls back to Resend's sandbox sender (onboarding@resend.dev), which can only
# deliver to the email address that owns the Resend account.
CONTACT_FROM_EMAIL=

# --- Site ---
# Canonical URL used for metadata, sitemap, robots and OG tags. Defaults to siteConfig.url.
NEXT_PUBLIC_SITE_URL=

# Optional: Google Search Console HTML-tag verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
